#!/usr/bin/env bash
# EasyOTP dev driver. Wraps the build container so nothing lands on the host.
#
# Memory discipline is the point: this host runs ~4GB free, so the container is
# hard-capped and every long-lived JVM is stoppable. `./dev stop` when you walk
# away; `./dev purge` to reclaim everything.
set -euo pipefail

IMAGE=easyotp-build
REMOTE_IMAGE=${EASYOTP_IMAGE:-ghcr.io/amir-salmani/easyotp-build:latest}
CONTAINER=easyotp-dev
VOLUME=easyotp-gradle
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MEM=${EASYOTP_MEM:-5g}

# Run as the host uid/gid rather than trusting the image's USER. Ubuntu 24.04
# bases ship an `ubuntu` account already holding uid 1000, so an image that
# tried to create its own user there may not have one. Overriding here keeps
# bind-mounted files host-owned and works whichever way the image was built.
AS_USER=(--user "$(id -u):$(id -g)" -e HOME=/home/dev)

# Allocate a TTY only when there is one, so ./dev works from scripts and CI.
TTY=(-i); [[ -t 0 && -t 1 ]] && TTY=(-it)
TOOLS_URL_OVERRIDE=${EASYOTP_TOOLS_URL:-}

have_container() { docker ps -aq -f name="^${CONTAINER}$" | grep -q .; }
running()        { docker ps  -q -f name="^${CONTAINER}$" | grep -q .; }

# Google's cmdline-tools filenames embed a build number and 404 without notice.
# Resolve the current one from the repository manifest so the image never rots.
resolve_cmdline_tools() {
  local xml url
  [[ -n $TOOLS_URL_OVERRIDE ]] && { echo "$TOOLS_URL_OVERRIDE"; return 0; }
  for m in repository2-3.xml repository2-1.xml; do
    xml=$(curl -fsSL --max-time 20 "https://dl.google.com/android/repository/$m" 2>/dev/null) || continue
    url=$(grep -o 'commandlinetools-linux-[0-9]\+_latest\.zip' <<<"$xml" | sort -u | tail -1) || true
    [[ -n ${url:-} ]] && { echo "https://dl.google.com/android/repository/$url"; return 0; }
  done
  return 1
}

# Preferred path: pull the image CI already built.
#
# The primary workstation is in Iran, where dl.google.com (Android SDK) and
# Docker Hub are both blocked but ghcr.io is reachable. A local build cannot
# succeed there -- it fails at the base image before it ever reaches the SDK.
# Pulling also guarantees local and CI run the identical environment.
pull_image() {
  echo "pulling $REMOTE_IMAGE ..."
  docker pull "$REMOTE_IMAGE" || return 1
  docker tag "$REMOTE_IMAGE" "$IMAGE"
}

build_image() {
  local tools
  if ! tools=$(resolve_cmdline_tools); then
    cat >&2 <<'ERR'
Cannot build the image locally: dl.google.com is unreachable from here.

Google restricts Android SDK downloads from some regions, and Docker Hub blocks
others, so a local build fails at the base image regardless. Use the image built
by CI instead -- ghcr.io is reachable where those are not:

    gh auth token | docker login ghcr.io -u <your-github-user> --password-stdin
    ./dev pull

Push to main (or run the dev-image workflow) if it has not been published yet.
To force a local build anyway, supply the tools URL:

    EASYOTP_TOOLS_URL=<url> ./dev build-image
ERR
    return 1
  fi
  echo "cmdline-tools: $tools"
  docker build \
    --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
    --build-arg CMDLINE_TOOLS_URL="$tools" \
    -t "$IMAGE" "$ROOT/.devcontainer"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  pull_image && return 0
  echo "pull failed; attempting a local build" >&2
  build_image
}

up() {
  ensure_image || return 1
  running && return 0
  # A container keeps the flags it was created with, so one made by an older
  # ./dev stays broken forever. Recreate rather than leave it wedged.
  if have_container; then
    docker start "$CONTAINER" >/dev/null 2>&1 && return 0
    echo "existing container will not start; recreating" >&2
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  fi
  docker volume inspect "$VOLUME" >/dev/null 2>&1 || docker volume create "$VOLUME" >/dev/null
  docker run -d --name "$CONTAINER" \
    "${AS_USER[@]}" \
    --memory="$MEM" --memory-swap="$MEM" --cpus=4 \
    -v "$ROOT:/workspace" \
    -v "$VOLUME:/home/dev/.gradle" \
    --network host \
    "$IMAGE" sleep infinity >/dev/null
}

case "${1:-help}" in
  up)      up; echo "container up (capped at $MEM)" ;;
  shell)   up; shift; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" bash "$@" ;;
  run)     up; shift; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" "$@" ;;
  build)   up; shift; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" ./gradlew "${@:-assembleDebug}" ;;
  pull)        pull_image ;;
  build-image) build_image ;;
  rebuild)     docker rmi -f "$IMAGE" 2>/dev/null || true; ensure_image ;;

  # Wireless ADB: Settings > Developer options > Wireless debugging on the handset.
  # Avoids USB passthrough and the udev rules this host does not have.
  pair)    up; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" adb pair "${2:?usage: ./dev pair HOST:PORT}" ;;
  connect) up; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" adb connect "${2:?usage: ./dev connect HOST:PORT}" ;;
  install) up; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" adb install -r \
             "app/build/outputs/apk/debug/app-debug.apk" ;;
  logcat)  up; docker exec "${TTY[@]}" "${AS_USER[@]}" "$CONTAINER" adb logcat -s EasyOTP:V ;;

  stop)
    running && docker exec "${AS_USER[@]}" "$CONTAINER" ./gradlew --stop >/dev/null 2>&1 || true
    running && docker stop "$CONTAINER" >/dev/null || true
    echo "stopped; host RAM released"
    ;;

  status)
    printf 'image     '; docker images -q "$IMAGE" | grep -q . \
      && docker images --format '{{.Size}}' "$IMAGE" || echo "not built"
    printf 'container '; running && echo "running" || { have_container && echo "stopped" || echo "absent"; }
    printf 'volume    '; docker volume inspect "$VOLUME" >/dev/null 2>&1 && echo "present" || echo "absent"
    running && docker stats --no-stream --format '  mem {{.MemUsage}}  cpu {{.CPUPerc}}' "$CONTAINER"
    echo "host:"; free -h | sed -n 2p | sed 's/^/  /'
    ;;

  purge)
    read -rp "Remove container, image and Gradle cache volume? [y/N] " a
    [[ ${a,,} == y ]] || { echo "aborted"; exit 0; }
    docker rm -f "$CONTAINER" 2>/dev/null || true
    docker rmi -f "$IMAGE"    2>/dev/null || true
    docker volume rm "$VOLUME" 2>/dev/null || true
    echo "purged"
    ;;

  *)
    cat <<'USAGE'
./dev up                 start the build container (hard memory cap)
./dev build [task]       gradlew task, default assembleDebug
./dev shell              interactive shell inside the container
./dev pair HOST:PORT     wireless ADB pairing (Developer options)
./dev connect HOST:PORT  wireless ADB connect
./dev install            install the debug APK on the connected device
./dev logcat             tail EasyOTP logs
./dev status             image/container/volume state + host memory
./dev stop               stop Gradle daemons and the container (frees RAM)
./dev pull               pull the CI-built image from ghcr.io (use this in Iran)
./dev build-image        build the image locally (needs dl.google.com)
./dev rebuild            drop the local image and fetch it again
./dev purge              remove container, image and Gradle cache
USAGE
    ;;
esac
